{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/source-anchor.schema.json",
  "title": "Source Anchor 1.3",
  "description": "Text offsets are UTF-8 byte offsets into text-v1 canonical text. Start is inclusive and end is exclusive.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "text_start", "text_end", "offset_unit", "range_semantics", "normalization_version"],
      "properties": {
        "kind": { "const": "PDF" },
        "page": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "text_start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "text_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "offset_unit": { "const": "UTF8_BYTE" },
        "range_semantics": { "const": "START_INCLUSIVE_END_EXCLUSIVE" },
        "normalization_version": { "const": "text-v1" },
        "bounding_boxes": {
          "type": "array",
          "items": { "$ref": "#/$defs/pdfBox" }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "section_path", "paragraph_id", "text_start", "text_end", "offset_unit", "range_semantics", "normalization_version"],
      "properties": {
        "kind": { "const": "DOCX" },
        "section_path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\r\\n]+$" }
        },
        "paragraph_id": {
          "type": "string",
          "pattern": "^(?:native:[A-Za-z0-9._~:-]{1,240}|derived:sha256:[0-9a-f]{64})$",
          "maxLength": 256
        },
        "text_start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "text_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "offset_unit": { "const": "UTF8_BYTE" },
        "range_semantics": { "const": "START_INCLUSIVE_END_EXCLUSIVE" },
        "normalization_version": { "const": "text-v1" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slide", "shape_id", "text_start", "text_end", "offset_unit", "range_semantics", "normalization_version"],
      "properties": {
        "kind": { "const": "PPTX" },
        "slide": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "shape_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "text_start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "text_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "offset_unit": { "const": "UTF8_BYTE" },
        "range_semantics": { "const": "START_INCLUSIVE_END_EXCLUSIVE" },
        "normalization_version": { "const": "text-v1" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sheet", "range"],
      "properties": {
        "kind": { "const": "XLSX" },
        "sheet": { "type": "string", "minLength": 1, "maxLength": 255 },
        "range": { "type": "string", "pattern": "^[A-Z]+[1-9][0-9]*(?::[A-Z]+[1-9][0-9]*)?$" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "message_id", "mime_part", "text_start", "text_end", "offset_unit", "range_semantics", "normalization_version"],
      "properties": {
        "kind": { "const": "EMAIL" },
        "message_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "mime_part": { "type": "string", "minLength": 1, "maxLength": 256 },
        "text_start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "text_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "offset_unit": { "const": "UTF8_BYTE" },
        "range_semantics": { "const": "START_INCLUSIVE_END_EXCLUSIVE" },
        "normalization_version": { "const": "text-v1" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "commit_sha", "path", "line_start", "line_end"],
      "properties": {
        "kind": { "const": "GIT" },
        "repository": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\/$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F]).+$" },
        "line_start": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "line_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "canonical_url", "dom_path", "text_start", "text_end", "offset_unit", "range_semantics", "normalization_version"],
      "properties": {
        "kind": { "const": "HTML" },
        "canonical_url": { "type": "string", "format": "uri", "maxLength": 8192 },
        "dom_path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "text_start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "text_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "offset_unit": { "const": "UTF8_BYTE" },
        "range_semantics": { "const": "START_INCLUSIVE_END_EXCLUSIVE" },
        "normalization_version": { "const": "text-v1" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "line_start", "line_end"],
      "properties": {
        "kind": { "const": "TEXT" },
        "line_start": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "line_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "connection_id",
        "projection_lineage_id",
        "projection_revision",
        "projection_contract_hash",
        "entity_identity_digest",
        "row_version_hash",
        "column_ordinal",
        "column_name",
        "canonical_value_hash",
        "text_start",
        "text_end",
        "offset_unit",
        "range_semantics",
        "normalization_version"
      ],
      "properties": {
        "kind": { "const": "POSTGRESQL_QUERY_CELL" },
        "connection_id": { "$ref": "#/$defs/id" },
        "projection_lineage_id": { "$ref": "#/$defs/id" },
        "projection_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "projection_contract_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "entity_identity_digest": { "type": "string", "pattern": "^hmac-sha256:k[1-9][0-9]{0,8}:[0-9a-f]{64}$" },
        "row_version_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "column_ordinal": { "type": "integer", "minimum": 1, "maximum": 256 },
        "column_name": { "type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Za-z_][A-Za-z0-9_$]*$" },
        "canonical_value_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "json_path": { "type": "string", "maxLength": 4096, "pattern": "^(?:|/(?:[^~\\u0000-\\u001F\\u007F-\\u009F\\r\\n]|~[01])*)$" },
        "text_start": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "text_end": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "offset_unit": { "const": "UTF8_BYTE" },
        "range_semantics": { "const": "START_INCLUSIVE_END_EXCLUSIVE" },
        "normalization_version": { "const": "text-v1" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page",
        "token_start_ordinal",
        "token_end_ordinal",
        "range_semantics",
        "coordinate_unit",
        "coordinate_origin",
        "bounding_boxes"
      ],
      "properties": {
        "kind": { "const": "OCR" },
        "page": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "token_start_ordinal": { "type": "integer", "minimum": 0, "maximum": 9007199254740990 },
        "token_end_ordinal": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "range_semantics": { "const": "START_INCLUSIVE_END_EXCLUSIVE" },
        "coordinate_unit": { "const": "NORMALIZED_0_1" },
        "coordinate_origin": { "const": "TOP_LEFT" },
        "bounding_boxes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/normalizedBox" }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "pdfBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "coordinate_unit", "coordinate_origin"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
        "y": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "coordinate_unit": { "const": "PDF_POINT" },
        "coordinate_origin": { "const": "TOP_LEFT" }
      }
    },
    "normalizedBox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
