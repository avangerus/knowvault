{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/pdf-parser-result-v1.schema.json",
  "title": "PDF Parser Result v1",
  "description": "Closed, versioned wire result of the isolated text-PDF observer. The worker reports only the observed page, bounded PDF-point geometry and raw Unicode text. It owns no canonicalization, byte range, hash or anchor; the Go pdfparser package canonicalizes raw_text, derives the full unit range and builds the PDF source anchor. No database, tenant, lifecycle or queryability fields are permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "observed_format", "parser", "text_units", "warnings"],
  "properties": {
    "result_version": { "const": "pdf-parser-result-v1" },
    "observed_format": {
      "description": "The source format observed by the worker. PDF is the only format accepted by this protocol.",
      "const": "PDF"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact_hash", "observation_profile_revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "artifact_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "observation_profile_revision": {
          "description": "Version of observation semantics only. It never denotes a normalization or anchor authority.",
          "type": "string",
          "pattern": "^[a-z0-9]+-obs-v[1-9][0-9]*$"
        }
      }
    },
    "text_units": {
      "description": "One bounded raw-text observation per page. An empty array is reserved for the explicit SCANNED_OR_MIXED_PDF classification; the Go runtime derives the complete UTF-8 byte range over text-v1 canonical page text.",
      "type": "array",
      "minItems": 0,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "locator", "raw_text"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "locator": { "$ref": "#/$defs/pdfLocator" },
          "raw_text": {
            "description": "Raw, not canonicalized Unicode text exactly as observed on the page.",
            "type": "string",
            "minLength": 1,
            "maxLength": 262144
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "text_units": { "type": "array", "maxItems": 0 }
        },
        "required": ["text_units"]
      },
      "then": {
        "properties": {
          "warnings": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["code"],
              "properties": { "code": { "const": "SCANNED_OR_MIXED_PDF" } }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "warnings": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["code"],
              "properties": { "code": { "const": "SCANNED_OR_MIXED_PDF" } }
            }
          }
        },
        "required": ["warnings"]
      },
      "then": {
        "properties": { "text_units": { "type": "array", "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": {
          "warnings": {
            "type": "array",
            "not": {
              "contains": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "const": "SCANNED_OR_MIXED_PDF" } }
              }
            }
          }
        },
        "required": ["warnings"]
      },
      "then": {
        "properties": { "text_units": { "type": "array", "minItems": 1 } }
      }
    }
  ],
  "$defs": {
    "pdfLocator": {
      "description": "PDF structural observation: one 1-based page plus non-empty geometry in PDF points with a top-left origin. It contains no offsets, hashes, canonical text or ready-made anchor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "page", "page_width", "page_height", "rotation", "bounding_boxes"],
      "properties": {
        "kind": { "const": "PDF" },
        "page": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "page_width": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "page_height": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "rotation": { "type": "integer", "minimum": 0, "maximum": 270, "enum": [0, 90, 180, 270] },
        "bounding_boxes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/pdfRectangle" }
        }
      }
    },
    "pdfRectangle": {
      "description": "Finite, positive PDF-point rectangle. The parser additionally rejects x+width or y+height beyond the safe numeric bound.",
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height", "coordinate_unit", "coordinate_origin"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
        "y": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 9007199254740991 },
        "coordinate_unit": { "const": "PDF_POINT" },
        "coordinate_origin": { "const": "TOP_LEFT" }
      }
    }
  }
}
