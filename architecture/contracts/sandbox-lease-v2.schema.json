{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/sandbox-lease-v2.schema.json",
  "title": "Sandbox Lease 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lease_id", "job_id", "worker_id", "parser_request", "issued_at", "expires_at", "attempt", "state"],
  "properties": {
    "schema_version": { "const": "sandbox-lease-v2" },
    "lease_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "worker_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "parser_request": { "$ref": "https://knowvault.local/schemas/sandbox-parser-request-v1.schema.json" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "state": { "enum": ["OFFERED", "CLAIMED", "TRANSFERRED", "QUARANTINED", "COMPLETED", "EXPIRED"] }
  }
}
