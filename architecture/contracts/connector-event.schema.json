{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/connector-event.schema.json",
  "title": "Connector Event 1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "claimed_organization_id",
    "connection_id",
    "source_scope_id",
    "scope_revision",
    "connector_job_id",
    "operation",
    "delete_semantics",
    "external_object_id",
    "external_version_key",
    "object_type",
    "object_metadata",
    "content_reference",
    "acl_snapshot",
    "event_time",
    "observed_at",
    "idempotency_key",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "1.3" },
    "event_id": { "type": "string", "format": "uuid" },
    "claimed_organization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Untrusted claim. The server derives organization from registered mTLS connector identity and compares it."
    },
    "connection_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "source_scope_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "scope_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "connector_job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": {
      "enum": ["UPSERT", "DELETE", "ACL_CHANGED", "MOVED", "VERSION_CHANGED", "RESTORE"]
    },
    "delete_semantics": {
      "type": ["string", "null"],
      "enum": ["SOURCE_OBJECT_DELETED", "SCOPE_MEMBERSHIP_REMOVED", null]
    },
    "external_object_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "external_version_key": {
      "type": ["string", "null"],
      "pattern": "^(?:native:[A-Za-z0-9._~:/+=%@-]{1,1017}|hash:sha256:[0-9a-f]{64})$",
      "maxLength": 1024
    },
    "object_type": {
      "enum": ["FILE", "GIT_FILE", "EMAIL", "EMAIL_ATTACHMENT", "WEB_PAGE"]
    },
    "object_metadata": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/fileMetadata" },
        { "$ref": "#/$defs/gitMetadata" },
        { "$ref": "#/$defs/emailMetadata" },
        { "$ref": "#/$defs/emailAttachmentMetadata" },
        { "$ref": "#/$defs/webMetadata" }
      ]
    },
    "content_reference": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/contentReference" }
      ]
    },
    "acl_snapshot": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/aclSnapshot" }
      ]
    },
    "event_time": { "type": "string", "format": "date-time" },
    "observed_at": { "type": "string", "format": "date-time" },
    "idempotency_key": { "type": "string", "minLength": 16, "maxLength": 256 },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "allOf": [
    {
      "if": { "allOf": [
        { "type": "object", "properties": { "object_type": { "const": "FILE" } }, "required": ["object_type"] },
        { "type": "object", "properties": { "operation": { "enum": ["UPSERT", "VERSION_CHANGED", "RESTORE", "MOVED"] } }, "required": ["operation"] }
      ] },
      "then": { "type": "object", "properties": { "object_metadata": { "$ref": "#/$defs/fileMetadata" } } }
    },
    {
      "if": { "allOf": [
        { "type": "object", "properties": { "object_type": { "const": "GIT_FILE" } }, "required": ["object_type"] },
        { "type": "object", "properties": { "operation": { "enum": ["UPSERT", "VERSION_CHANGED", "RESTORE", "MOVED"] } }, "required": ["operation"] }
      ] },
      "then": { "type": "object", "properties": { "object_metadata": { "$ref": "#/$defs/gitMetadata" } } }
    },
    {
      "if": { "allOf": [
        { "type": "object", "properties": { "object_type": { "const": "EMAIL" } }, "required": ["object_type"] },
        { "type": "object", "properties": { "operation": { "enum": ["UPSERT", "VERSION_CHANGED", "RESTORE", "MOVED"] } }, "required": ["operation"] }
      ] },
      "then": { "type": "object", "properties": { "object_metadata": { "$ref": "#/$defs/emailMetadata" } } }
    },
    {
      "if": { "allOf": [
        { "type": "object", "properties": { "object_type": { "const": "EMAIL_ATTACHMENT" } }, "required": ["object_type"] },
        { "type": "object", "properties": { "operation": { "enum": ["UPSERT", "VERSION_CHANGED", "RESTORE", "MOVED"] } }, "required": ["operation"] }
      ] },
      "then": { "type": "object", "properties": { "object_metadata": { "$ref": "#/$defs/emailAttachmentMetadata" } } }
    },
    {
      "if": { "allOf": [
        { "type": "object", "properties": { "object_type": { "const": "WEB_PAGE" } }, "required": ["object_type"] },
        { "type": "object", "properties": { "operation": { "enum": ["UPSERT", "VERSION_CHANGED", "RESTORE", "MOVED"] } }, "required": ["operation"] }
      ] },
      "then": { "type": "object", "properties": { "object_metadata": { "$ref": "#/$defs/webMetadata" } } }
    },
    {
      "if": { "type": "object", "properties": { "operation": { "enum": ["UPSERT", "VERSION_CHANGED", "RESTORE"] } }, "required": ["operation"] },
      "then": {
        "type": "object",
        "properties": {
          "external_version_key": { "type": "string" },
          "content_reference": { "$ref": "#/$defs/contentReference" }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "operation": { "const": "DELETE" } }, "required": ["operation"] },
      "then": {
        "type": "object",
        "properties": {
          "delete_semantics": { "enum": ["SOURCE_OBJECT_DELETED", "SCOPE_MEMBERSHIP_REMOVED"] },
          "external_version_key": { "type": "null" },
          "object_metadata": { "type": "null" },
          "content_reference": { "type": "null" },
          "acl_snapshot": { "type": "null" }
        }
      }
    },
    {
      "if": { "type": "object", "properties": { "operation": { "not": { "const": "DELETE" } } }, "required": ["operation"] },
      "then": { "type": "object", "properties": { "delete_semantics": { "type": "null" } } }
    },
    {
      "if": { "type": "object", "properties": { "operation": { "const": "ACL_CHANGED" } }, "required": ["operation"] },
      "then": {
        "type": "object",
        "properties": {
          "object_metadata": { "type": "null" },
          "content_reference": { "type": "null" },
          "acl_snapshot": { "$ref": "#/$defs/aclSnapshot" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fileMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "mime_type", "source_updated_at", "size_bytes", "relative_path", "canonical_locator_hash"],
      "properties": {
        "kind": { "const": "FILE" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "mime_type": { "type": "string", "minLength": 1, "maxLength": 255 },
        "source_updated_at": { "type": "string", "format": "date-time" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\/$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F]).+$", "maxLength": 4096 },
        "canonical_locator_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "gitMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "mime_type", "source_updated_at", "size_bytes", "provider", "repository", "commit_sha", "branch", "path", "canonical_locator_hash"],
      "properties": {
        "kind": { "const": "GIT_FILE" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "mime_type": { "type": "string", "minLength": 1, "maxLength": 255 },
        "source_updated_at": { "type": "string", "format": "date-time" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "provider": { "enum": ["GENERIC", "GITHUB", "GITLAB"] },
        "repository": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\/$)(?!.*[\\u0000-\\u001F\\u007F-\\u009F]).+$", "maxLength": 4096 },
        "canonical_locator_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "emailMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject", "mime_type", "source_updated_at", "size_bytes", "immutable_message_id", "thread_id", "mailbox_id", "folder_id", "sender", "recipients", "sent_at", "canonical_locator_hash"],
      "properties": {
        "kind": { "const": "EMAIL" },
        "subject": { "type": "string", "maxLength": 2048 },
        "mime_type": { "type": "string", "minLength": 1, "maxLength": 255 },
        "source_updated_at": { "type": "string", "format": "date-time" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "immutable_message_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "thread_id": { "type": ["string", "null"], "maxLength": 2048 },
        "mailbox_id": { "type": "string", "minLength": 1, "maxLength": 512 },
        "folder_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sender": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "recipients": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "sent_at": { "type": "string", "format": "date-time" },
        "canonical_locator_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "emailAttachmentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "mime_type", "source_updated_at", "size_bytes", "parent_message_external_object_id", "mime_part_id", "canonical_locator_hash"],
      "properties": {
        "kind": { "const": "EMAIL_ATTACHMENT" },
        "title": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "mime_type": { "type": "string", "minLength": 1, "maxLength": 255 },
        "source_updated_at": { "type": "string", "format": "date-time" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "parent_message_external_object_id": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "mime_part_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "canonical_locator_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "webMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "mime_type", "source_updated_at", "size_bytes", "canonical_url", "etag", "last_modified", "canonical_locator_hash"],
      "properties": {
        "kind": { "const": "WEB_PAGE" },
        "title": { "type": "string", "maxLength": 2048 },
        "mime_type": { "const": "text/html" },
        "source_updated_at": { "type": ["string", "null"], "format": "date-time" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "canonical_url": { "type": "string", "format": "uri", "pattern": "^https?://", "maxLength": 8192 },
        "etag": { "type": ["string", "null"], "maxLength": 2048 },
        "last_modified": { "type": ["string", "null"], "format": "date-time" },
        "canonical_locator_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "contentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_id", "expires_at", "content_hash", "size_bytes", "media_type"],
      "properties": {
        "reference_id": { "type": "string", "pattern": "^cr_[A-Za-z0-9_-]{16,256}$" },
        "expires_at": { "type": "string", "format": "date-time" },
        "content_hash": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1073741824 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "aclSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "principal_tokens", "resolved_at", "expires_at", "content_hash"],
      "properties": {
        "status": { "enum": ["RESOLVED", "NOT_APPLICABLE"] },
        "principal_tokens": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/principalToken" }
        },
        "resolved_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "principalToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "type", "subject", "revision"],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^(?!.*\\*)[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"
        },
        "type": { "enum": ["USER", "GROUP", "SERVICE", "SPECIAL"] },
        "subject": {
          "type": "string",
          "pattern": "^(?!.*\\*)(?!.*\\s)[^\\u0000-\\u001F\\u007F]{1,512}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?!.*\\*)[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signed_at", "nonce", "payload_hash", "value_base64"],
      "properties": {
        "algorithm": { "const": "ED25519" },
        "key_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "signed_at": { "type": "string", "format": "date-time" },
        "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22,128}$" },
        "payload_hash": { "$ref": "#/$defs/sha256" },
        "value_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
      }
    }
  }
}
