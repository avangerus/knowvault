{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/source-discovery-request.schema.json",
  "title": "Source Discovery Request 1.0",
  "description": "Closed worker-owned request envelope for one bounded source catalog probe. It carries only opaque IDs, hashes, trusted recheck values, limits and timestamps; credentials, DSNs, SQL and source data are excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "organization_id",
    "actor_principal_id",
    "connection_id",
    "connection_revision",
    "trust_profile_hash",
    "security_epoch",
    "max_views",
    "max_columns",
    "max_comment_bytes",
    "statement_timeout_ms",
    "transaction_timeout_ms",
    "idempotency_key_hash",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "source-discovery-request-v1" },
    "request_id": { "$ref": "#/$defs/id" },
    "organization_id": { "$ref": "#/$defs/id" },
    "actor_principal_id": { "$ref": "#/$defs/id" },
    "connection_id": { "$ref": "#/$defs/id" },
    "connection_revision": { "$ref": "#/$defs/safePositiveInteger" },
    "trust_profile_hash": { "$ref": "#/$defs/sha256Hash" },
    "security_epoch": { "$ref": "#/$defs/safePositiveInteger" },
    "max_views": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "max_columns": { "type": "integer", "minimum": 1, "maximum": 256 },
    "max_comment_bytes": { "type": "integer", "minimum": 0, "maximum": 65536 },
    "statement_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 300000 },
    "transaction_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 600000 },
    "idempotency_key_hash": { "$ref": "#/$defs/sha256Hash" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
