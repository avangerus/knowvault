{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/pdf-render-result-v1.schema.json",
  "title": "PDF Render Result v1",
  "description": "Closed deterministic PDFBox page-render observation. The renderer supplies only bounded transient PNG pages and its immutable identity; page order, pixel limits and PNG validity are re-validated by Go before OCR.",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_version", "observed_format", "renderer", "pages", "warnings"],
  "properties": {
    "result_version": { "const": "pdf-render-result-v1" },
    "observed_format": { "const": "PDF" },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "artifact_hash", "renderer_profile_revision"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "artifact_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "renderer_profile_revision": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "page", "pixel_width", "pixel_height", "png_base64"],
        "properties": {
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "page": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "pixel_width": { "type": "integer", "minimum": 1, "maximum": 50000000 },
          "pixel_height": { "type": "integer", "minimum": 1, "maximum": 50000000 },
          "png_base64": { "type": "string", "minLength": 8, "maxLength": 22369624, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code"],
        "properties": { "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } }
      }
    }
  }
}
