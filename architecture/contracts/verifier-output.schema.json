{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/verifier-output.schema.json",
  "title": "Verifier Output 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "results"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "verification_input_hash", "outcome"],
      "properties": {
        "claim_id": { "type": "string", "pattern": "^C[1-9][0-9]*$" },
        "verification_input_hash": { "$ref": "#/$defs/sha256" },
        "outcome": {
          "enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "UNSUPPORTED", "CONTRADICTED"]
        }
      }
    }
  }
}
