{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/source-discovery-result.schema.json",
  "title": "Source Discovery Result 1.0",
  "description": "Closed worker-owned terminal result for one bounded source catalog probe. Counts, hashes, status and the opaque encrypted metadata artifact are exposed; native catalog rows, credentials, DSNs, OIDs and privilege graphs are not.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_id",
    "request_id",
    "organization_id",
    "actor_principal_id",
    "connection_id",
    "connection_revision",
    "database_identity_hash",
    "trust_profile_hash",
    "privilege_digest",
    "security_epoch",
    "status",
    "view_count",
    "prepared_view_count",
    "needs_interpretation_view_count",
    "metadata_artifact_id",
    "metadata_plaintext_hash",
    "result_hash",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": { "const": "source-discovery-result-v1" },
    "result_id": { "$ref": "#/$defs/id" },
    "request_id": { "$ref": "#/$defs/id" },
    "organization_id": { "$ref": "#/$defs/id" },
    "actor_principal_id": { "$ref": "#/$defs/id" },
    "connection_id": { "$ref": "#/$defs/id" },
    "connection_revision": { "$ref": "#/$defs/safePositiveInteger" },
    "database_identity_hash": { "$ref": "#/$defs/sha256Hash" },
    "trust_profile_hash": { "$ref": "#/$defs/sha256Hash" },
    "privilege_digest": { "$ref": "#/$defs/sha256Hash" },
    "security_epoch": { "$ref": "#/$defs/safePositiveInteger" },
    "status": { "enum": ["SUCCEEDED", "NEEDS_INTERPRETATION"] },
    "view_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "prepared_view_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "needs_interpretation_view_count": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "metadata_artifact_id": { "$ref": "#/$defs/id" },
    "metadata_plaintext_hash": { "$ref": "#/$defs/sha256Hash" },
    "result_hash": { "$ref": "#/$defs/sha256Hash" },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "SUCCEEDED" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "needs_interpretation_view_count": { "const": 0 } }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256Hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
