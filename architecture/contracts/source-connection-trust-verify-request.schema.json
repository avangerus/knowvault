{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/source-connection-trust-verify-request.schema.json",
  "title": "Source Connection Trust Verify Request 1.0",
  "description": "ADR-0087 §2 canonical request envelope whose RFC 8785 JCS bytes bind the actor-scoped idempotency receipt (public.source_connection_trust_verification, migration 000057) to exactly this request; the raw Idempotency-Key itself never enters this envelope. Every field is closed: no free-form metadata, no client-owned server field (verification_id, verified_by, verified_at, canonical_hash) may appear here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "connection_id",
    "attested_connector_identity",
    "attested_by",
    "attested_at"
  ],
  "properties": {
    "schema_version": { "const": "source-connection-trust-verify-request-v1" },
    "operation": { "const": "VERIFY_TRUST" },
    "connection_id": { "$ref": "#/$defs/id" },
    "attested_connector_identity": { "$ref": "#/$defs/attestationText512" },
    "attested_by": { "$ref": "#/$defs/attestationText256" },
    "attested_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "attestationText512": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "attestationText256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
