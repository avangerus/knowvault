{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowvault.local/schemas/sandbox-limit-confirmation.schema.json",
  "title": "Sandbox Kernel Limit Confirmation 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "lease_id", "job_id", "worker_id", "observed_at",
    "observation_method", "limits", "extraction_identity", "confirmed"
  ],
  "properties": {
    "schema_version": { "const": "sandbox-limit-confirmation-v1" },
    "lease_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "job_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "worker_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "observed_at": { "type": "string", "format": "date-time" },
    "observation_method": { "const": "KERNEL_CGROUP_NAMESPACE" },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_millis", "memory_bytes", "pids_max", "wall_clock_ms"],
      "properties": {
        "cpu_millis": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "memory_bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "pids_max": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "wall_clock_ms": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "extraction_identity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "confirmed": { "const": true }
  }
}
