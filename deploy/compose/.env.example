# Copy to .env and fill in. Every value here is local install configuration,
# never a product secret checked into the repository.

# The organization, workspace and first OWNER bootstrap.sh creates for you.
KNOWVAULT_ORGANIZATION_ID=org_001
KNOWVAULT_WORKSPACE_ID=ws_001
KNOWVAULT_WORKSPACE_NAME=Operations
KNOWVAULT_OWNER_PRINCIPAL_ID=owner
KNOWVAULT_OWNER_DISPLAY_NAME=Owner
# Keycloak login username for that OWNER (its generated password is printed
# by bootstrap.sh and saved to deploy/compose/secrets/owner.password).
KNOWVAULT_OWNER_USERNAME=owner

# Local service passwords bootstrap.sh uses to start postgres/keycloak.
# Generate your own, e.g.: openssl rand -hex 32
KNOWVAULT_POSTGRES_PASSWORD=replace-with-a-local-secret
KNOWVAULT_KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-secret
KNOWVAULT_KEYCLOAK_DB_PASSWORD=replace-with-a-local-secret

# Separation of duty for source trust verification (ADR-0087 §2): a source
# confirmation and its trust verification must never be granted by the same
# person. false (the default) self-grants the organization's CONNECTOR_ADMIN
# role to the OWNER above, so a single-operator install can still verify
# trust alone. true instead provisions a second principal, with its own
# Keycloak login, holding CONNECTOR_ADMIN -- fill in the two lines below when
# you set this to true.
KNOWVAULT_DUAL_CONTROL=false
# KNOWVAULT_CONNECTOR_ADMIN_USERNAME=connector-admin-verifier
# KNOWVAULT_CONNECTOR_ADMIN_DISPLAY_NAME=Connector Admin Verifier
