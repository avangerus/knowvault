FROM golang:1.26.5-bookworm@sha256:e60d708a92ad26a6d61901334510d3debd23ddcba125663ecd6008d42e8ec669 AS builder

WORKDIR /src
ENV GOTOOLCHAIN=local
ENV GOEXPERIMENT=jsonv2
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
ARG REVISION=unknown
ARG BUILT_AT=unknown

COPY go.mod go.sum ./
COPY cmd/sandbox-dispatcher ./cmd/sandbox-dispatcher
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -mod=readonly \
    -trimpath \
    -buildvcs=false \
    -ldflags="-s -w -X knowvault.local/verified-workspace/internal/platform/buildinfo.Version=${VERSION} -X knowvault.local/verified-workspace/internal/platform/buildinfo.Revision=${REVISION} -X knowvault.local/verified-workspace/internal/platform/buildinfo.BuiltAt=${BUILT_AT}" \
    -o /out/knowvault-sandbox-dispatcher ./cmd/sandbox-dispatcher

# The dispatcher is the privileged kernel-supervisor boundary described by the
# contract-only deployment manifest. The orchestrator mounts the socket tree
# and cgroup filesystem; the image only provides the static broker binary and
# an empty, root-owned starting directory.
RUN install -d -m 0700 /out/runtime/run/knowvault/sandbox

FROM scratch AS runtime
USER 0:0
COPY --from=builder /out/knowvault-sandbox-dispatcher /knowvault-sandbox-dispatcher
COPY --from=builder /out/runtime/run/knowvault/sandbox /run/knowvault/sandbox
ENTRYPOINT ["/knowvault-sandbox-dispatcher"]
