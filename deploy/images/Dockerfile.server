FROM golang:1.26.5-bookworm@sha256:e60d708a92ad26a6d61901334510d3debd23ddcba125663ecd6008d42e8ec669 AS builder

WORKDIR /src
ENV GOTOOLCHAIN=local
ENV GOEXPERIMENT=jsonv2
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
ARG REVISION=unknown
ARG BUILT_AT=unknown

COPY go.mod go.sum ./
COPY cmd/server ./cmd/server
COPY internal ./internal
COPY web/dist /out/runtime/web/dist

RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -mod=readonly \
    -trimpath \
    -buildvcs=false \
    -ldflags="-s -w -X knowvault.local/verified-workspace/internal/platform/buildinfo.Version=${VERSION} -X knowvault.local/verified-workspace/internal/platform/buildinfo.Revision=${REVISION} -X knowvault.local/verified-workspace/internal/platform/buildinfo.BuiltAt=${BUILT_AT}" \
    -o /out/knowvault-server ./cmd/server

RUN install -d -o 0 -g 65532 -m 0750 \
    /out/runtime/run/knowvault/secrets \
    /out/runtime/run/knowvault/trust \
    && chown -R 0:65532 /out/runtime/web \
    && find /out/runtime/web -type d -exec chmod 0550 {} + \
    && find /out/runtime/web -type f -exec chmod 0440 {} +

FROM scratch AS runtime
USER 65532:65532
COPY --from=builder /out/knowvault-server /knowvault-server
COPY --from=builder --chown=0:65532 --chmod=0750 /out/runtime/run/knowvault /run/knowvault
COPY --from=builder /out/runtime/web /web
ENTRYPOINT ["/knowvault-server"]
