  "universal_rules": {
    "max_chars": 1200,
    "forbidden_phrases": ["profile limits", "could not be completed"],
    "label_regex": "^[\\wА-яЁё ]{2,30}:\\s",
    "evidence_regex": "(?i)(evidence|Доказательств\\w*|Свидетельств\\w*)\\s*\\d",
    "verification_regex": "(?i)(verified|проверен\\w*)",
    "internal_regexes": ["conn_[0-9A-Z]", "observed_at", "paraphrase", "inbox/",
      "\\bpublic\\.[a-z_]+", "\\b[a-z][a-z0-9]*_[a-z0-9_]+\\b",
      "\\b(READY|DRAFT|FRESH|STALE|SUCCEEDED|UNKNOWN|POSTGRESQL_QUERY|INSUFFICIENT_EVIDENCE)\\b",
      "\\b[0-9a-f]{32,}\\b", "\\b[\\w-]+\\.(md|txt|json|csv)\\b"],
    "same_tool_argument_max": 2,
    "ru_cyrillic_ratio_min": 0.7,
    "en_cyrillic_ratio_max": 0.3,
    "ru_english_service_phrases": ["I am sorry", "I'm sorry", "As an AI", "I cannot", "I can't", "I could not", "I do not have", "I don't have", "Please try again"],
    "en_russian_service_phrases": ["Извините", "Я не могу", "Не удалось", "Попробуйте ещё раз", "Попробуйте еще раз"]
