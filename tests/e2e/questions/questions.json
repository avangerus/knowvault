      "CREATE TABLE public.container_group (id integer PRIMARY KEY, contract_id integer NOT NULL, code text NOT NULL, address text NOT NULL)",
      "INSERT INTO public.client (id, name, inn) VALUES (1, 'ООО «Северный Ветер»', '7701234567'), (2, 'ООО «Гранит»', '7809876543'), (3, 'ИП Кузнецов', '500100200300')",
      "INSERT INTO public.contract (id, number, client_id, status, signed_on, amount) VALUES (1, '12', 1, 'active', '2025-01-15', 900000.00), (2, '47', 1, 'active', '2025-03-12', 1250000.00), (3, '58', 3, 'active', '2025-04-02', 480000.00), (4, '61', 2, 'closed', '2024-11-20', 300000.00), (5, '73', 2, 'archived', '2023-06-05', 100000.00)",
      "INSERT INTO public.container_group (id, contract_id, code, address) VALUES (1, 1, 'МНО-01', 'ул. Лесная, 4'), (2, 1, 'МНО-02', 'ул. Полевая, 9'), (3, 2, 'МНО-03', 'ш. Кольцевое, 17'), (4, 2, 'МНО-04', 'ул. Речная, 3'), (5, 3, 'МНО-05', 'пер. Сосновый, 8')",
      "CREATE ROLE kv_e1a_q_contract LOGIN PASSWORD 'kv_e1a_q_contract_pw' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS",
      "CREATE ROLE kv_e1a_q_client LOGIN PASSWORD 'kv_e1a_q_client_pw' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS",
      "CREATE ROLE kv_e1a_q_container_group LOGIN PASSWORD 'kv_e1a_q_container_group_pw' NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT NOREPLICATION NOBYPASSRLS",
      "GRANT USAGE ON SCHEMA public TO kv_e1a_q_contract, kv_e1a_q_client, kv_e1a_q_container_group",
      "GRANT SELECT ON public.contract TO kv_e1a_q_contract",
      "GRANT SELECT ON public.client TO kv_e1a_q_client",
      "GRANT SELECT ON public.container_group TO kv_e1a_q_container_group",
