      "ALTER ROLE kv_e1a_q_contract SET work_mem = '16MB'",
      "ALTER ROLE kv_e1a_q_client SET temp_file_limit = '512MB'",
      "ALTER ROLE kv_e1a_q_client SET work_mem = '16MB'",
      "ALTER ROLE kv_e1a_q_container_group SET temp_file_limit = '512MB'",
      "ALTER ROLE kv_e1a_q_container_group SET work_mem = '16MB'"
    ],
